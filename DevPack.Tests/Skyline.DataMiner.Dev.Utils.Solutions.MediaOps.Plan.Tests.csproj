<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="MSTest.Sdk/3.6.4">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseVSTest>true</UseVSTest>
		<UserSecretsId>8460637e-ffaf-44fb-aab9-8df893d1b873</UserSecretsId>
		<RootNamespace>RT_MediaOps.Plan</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
		<PackageReference Include="Skyline.DataMiner.CICD.Tools.WinEncryptedKeys.Lib" />
		<PackageReference Include="Skyline.DataMiner.Core.DataMinerSystem.Common" />
		<PackageReference Include="Skyline.DataMiner.Dev.Common" />
		<PackageReference Include="Skyline.DataMiner.Utils.SecureCoding.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\DevPack\Skyline.DataMiner.Dev.Utils.Solutions.MediaOps.Plan.csproj" />
		<ProjectReference Include="..\DevPack.UnitTesting\Skyline.DataMiner.Dev.Utils.Solutions.MediaOps.Plan.UnitTesting.csproj" />
	</ItemGroup>
	<Target Name="CopyIntegrationTestOutputToTestPackage" AfterTargets="Build">
		<PropertyGroup>
			<QAOpsHarvestingOutput>..\QAOpsPackage\TestPackageContent\TestHarvesting\postbuild.generated\$(MSBuildProjectName)\</QAOpsHarvestingOutput>
		</PropertyGroup>
		<ItemGroup>
			<IntegrationTestOutput Include="$(OutputPath)**\*.*" />
		</ItemGroup>
		<RemoveDir Directories="$(QAOpsHarvestingOutput)" />
		<Copy
			SourceFiles="@(IntegrationTestOutput)"
			DestinationFiles="@(IntegrationTestOutput->'$(QAOpsHarvestingOutput)%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>