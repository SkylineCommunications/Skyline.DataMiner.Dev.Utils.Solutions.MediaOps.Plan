<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
		<MediaOpsLiveDevPackVersion>1.2.0-alpha004</MediaOpsLiveDevPackVersion>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.1" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.1" />
		<PackageVersion Include="Skyline.DataMiner.CICD.CSharpAnalysis.Analyzer" Version="2.1.2" />
		<PackageVersion Include="Skyline.DataMiner.CICD.Tools.WinEncryptedKeys.Lib" Version="2.1.0" />
		<PackageVersion Include="Skyline.DataMiner.ConnectorAPI.SkylineLockManager" Version="1.3.5" />
		<PackageVersion Include="Skyline.DataMiner.Core.AppPackageInstaller" Version="4.0.0" />
		<PackageVersion Include="Skyline.DataMiner.Core.DataMinerSystem.Common" Version="1.1.3.7" />
		<PackageVersion Include="Skyline.DataMiner.Dev.Automation" Version="10.6.3.1" />
		<PackageVersion Include="Skyline.DataMiner.Dev.Common" Version="10.6.3.1" />
		<PackageVersion Include="Skyline.DataMiner.Dev.Protocol" Version="10.6.3.1" />
		<PackageVersion Include="Skyline.DataMiner.Dev.Utils.SDM.Abstractions" Version="1.0.1" />
		<PackageVersion Include="Skyline.DataMiner.Dev.Utils.Solutions.Categories" Version="1.2.5" />
		<PackageVersion Include="Skyline.DataMiner.Dev.Utils.Solutions.MediaOps.Live" Version="$(MediaOpsLiveDevPackVersion)" />
		<PackageVersion Include="Skyline.DataMiner.SDM.Registration.Common" Version="2.0.5" />
		<PackageVersion Include="Skyline.DataMiner.Utils.DOM" Version="10.5.2.8" />
		<PackageVersion Include="Skyline.DataMiner.Utils.SecureCoding" Version="2.2.1" />
		<PackageVersion Include="Skyline.DataMiner.Utils.SecureCoding.Analyzers" Version="2.2.1" />
	</ItemGroup>
</Project>
